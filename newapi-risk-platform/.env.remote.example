APP_ENV=production
GATEWAY_PORT=8088
PUBLIC_BASE_URL=https://risk.example.com
LOG_LEVEL=info

# Remote PostgreSQL. Require TLS in production.
DATABASE_URL=postgres://risk_user:URL_ENCODED_PASSWORD@pg.example.internal:5432/risk?sslmode=verify-full
DATABASE_MAX_CONNS=120
DATABASE_MIN_CONNS=12

# redis:// or rediss://; Sentinel/Cluster can be exposed behind a managed endpoint.
REDIS_URL=rediss://default:URL_ENCODED_PASSWORD@redis.example.internal:6380/0
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=16
REDIS_REQUIRED=true

KAFKA_ENABLED=true
KAFKA_REQUIRED=true
KAFKA_BROKERS=kafka-1.example.internal:9093,kafka-2.example.internal:9093,kafka-3.example.internal:9093
KAFKA_CLIENT_ID=newapi-risk-gateway-prod
KAFKA_AUDIT_TOPIC=risk.audit.events
KAFKA_TRACE_TOPIC=risk.request.traces
KAFKA_DEADLETTER_TOPIC=risk.deadletter
KAFKA_AUTO_CREATE_TOPICS=false
KAFKA_TOPIC_PARTITIONS=24
KAFKA_REPLICATION_FACTOR=3
KAFKA_RETENTION_DAYS=365
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_USERNAME=risk_gateway
KAFKA_PASSWORD=CHANGE_ME
KAFKA_TLS_ENABLED=true
KAFKA_TLS_INSECURE_SKIP_VERIFY=false
KAFKA_CA_CERT_FILE=/run/secrets/kafka/ca.pem
KAFKA_CLIENT_CERT_FILE=
KAFKA_CLIENT_KEY_FILE=

ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
TRACKING_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
HASH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
MASTER_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
RISK_HTTP_STATUS=555

DEFAULT_ROUTE_KEY=default
DEFAULT_UPSTREAM_BASE_URL=
DEFAULT_UPSTREAM_AUTH_MODE=passthrough
ALLOW_PRIVATE_UPSTREAMS=false
TRUST_PROXY_HEADERS=true

AUDIT_MODEL_ENABLED=true
AUDIT_MODEL_URL=https://audit-model.example.internal/v1/chat/completions
AUDIT_MODEL_NAME=security-auditor-small
AUDIT_MODEL_API_KEY=CHANGE_ME
AUDIT_MODEL_MAX_CONCURRENCY=128
AUDIT_TIMEOUT=1200ms
AUDIT_FAIL_MODE=rules_only
AUDIT_QUEUE_SIZE=100000
AUDIT_WORKERS=32

HOT_RETENTION_DAYS=7
PAYLOAD_MODE=redacted
PAYLOAD_CAPTURE_BYTES=65536
MAX_REQUEST_BODY_BYTES=8388608
MAX_RESPONSE_BYTES=33554432
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=250
RATE_LIMIT_BURST=500
CLIENT_READ_TIMEOUT=60s
CLIENT_IDLE_TIMEOUT=120s
MAX_HEADER_BYTES=1048576
REQUEST_TIMEOUT=30m
SHUTDOWN_TIMEOUT=30s
CLEANUP_INTERVAL=1h
SETTINGS_REFRESH_INTERVAL=30s
UPSTREAM_MAX_IDLE_CONNS=8192
UPSTREAM_MAX_IDLE_CONNS_PER_HOST=2048
UPSTREAM_MAX_CONNS_PER_HOST=0
