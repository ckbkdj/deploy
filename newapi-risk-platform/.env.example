# Generated securely by: ./scripts/generate-env.sh .env
APP_ENV=production
GATEWAY_PORT=8088
PUBLIC_BASE_URL=http://localhost:8088
LOG_LEVEL=info

POSTGRES_DB=risk
POSTGRES_USER=risk
POSTGRES_PASSWORD=CHANGE_ME_HEX
DATABASE_URL=postgres://risk:CHANGE_ME_HEX@postgres:5432/risk?sslmode=disable
