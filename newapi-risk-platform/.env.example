KAFKA_BROKERS=kafka:19092
KAFKA_CLIENT_ID=newapi-risk-gateway
KAFKA_AUDIT_TOPIC=risk.audit.events
KAFKA_TRACE_TOPIC=risk.request.traces
KAFKA_DEADLETTER_TOPIC=risk.deadletter
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPIC_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_DAYS=180
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS_ENABLED=false
KAFKA_TLS_INSECURE_SKIP_VERIFY=false
