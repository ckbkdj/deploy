KAFKA_CLIENT_CERT_FILE=
KAFKA_CLIENT_KEY_FILE=

ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM
TRACKING_TOKEN=CHANGE_ME_LONG_RANDOM
HASH_SECRET=CHANGE_ME_LONG_RANDOM
MASTER_KEY=CHANGE_ME_LONG_RANDOM
